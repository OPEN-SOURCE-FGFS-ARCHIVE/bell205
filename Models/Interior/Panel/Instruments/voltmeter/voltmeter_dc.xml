<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>voltmeter_dc.ac</path>

  <effect>
    <inherits-from>Aircraft/bell205/Models/Effects/reflectglasint-uber</inherits-from>
    <object-name>glas</object-name>
  </effect>

  <effect>
    <condition>
      <property>sim/rendering/rembrandt/enabled</property>
    </condition>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>glas</object-name>
  </effect>

  <animation>
    <type>range</type>
    <object-name>glas</object-name>
    <object-name>face</object-name>
    <object-name>needle_bat</object-name>
    <object-name>needle_maingenerator</object-name>
    <object-name>needle_stbygenerator</object-name>
    <object-name>needle_essbus</object-name>
    <object-name>needle_nonessbus</object-name>
    <object-name>fond</object-name>
    <min-m>0</min-m>
    <max-m>20</max-m>
  </animation>

  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>needle_bat</object-name>
    <object-name>needle_maingenerator</object-name>
    <object-name>needle_stbygenerator</object-name>
    <object-name>needle_essbus</object-name>
    <object-name>needle_nonessbus</object-name>
    <condition>
      <property>systems/electrical/outputs/inst_panel_lights</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instltg/engine</factor-prop>
      <red>   0.1 </red>
      <green> 0.1 </green>
      <blue>  0.1 </blue>
    </emission>
  </animation>

  <animation>
    <type>select</type>
    <object-name>needle_bat</object-name>
    <condition>
      <equals>
        <property>controls/switches/vm</property>
        <value>0</value>
      </equals>
    </condition>
  </animation>
  <animation> 
    <type>rotate</type>
    <object-name>needle_bat</object-name>
    <property>systems/electrical/outputs/bus_battery</property>s
    <interpolation>
      <entry><ind>  0 </ind><dep> -54 </dep></entry>
      <entry><ind> 15 </ind><dep>   0 </dep></entry>
      <entry><ind> 30 </ind><dep>  54 </dep></entry>
    </interpolation>
    <center>
      <x-m> -0.001 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> -0.015 </z-m>  
    </center>
    <axis> 
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>select</type>
    <object-name>needle_maingenerator</object-name>
    <condition>
      <equals>
        <property>controls/switches/vm</property>
        <value>1</value>
      </equals>
    </condition>
  </animation>
  <animation> 
    <type>rotate</type>
    <object-name>needle_maingenerator</object-name>
    <property>systems/electrical/outputs/bus_maingenerator</property>s
    <interpolation>
      <entry><ind>  0 </ind><dep> -54 </dep></entry>
      <entry><ind> 15 </ind><dep>   0 </dep></entry>
      <entry><ind> 30 </ind><dep>  54 </dep></entry>
    </interpolation>
    <center>
      <x-m> -0.001 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> -0.015 </z-m>  
    </center>
    <axis> 
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>select</type>
    <object-name>needle_stbygenerator</object-name>
    <condition>
      <equals>
        <property>controls/switches/vm</property>
        <value>2</value>
      </equals>
    </condition>
  </animation>
  <animation> 
    <type>rotate</type>
    <object-name>needle_stbygenerator</object-name>
    <property>systems/electrical/outputs/bus_stbygenerator</property>s
    <interpolation>
      <entry><ind>  0 </ind><dep> -54 </dep></entry>
      <entry><ind> 15 </ind><dep>   0 </dep></entry>
      <entry><ind> 30 </ind><dep>  54 </dep></entry>
    </interpolation>
    <center>
      <x-m> -0.001 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> -0.015 </z-m>  
    </center>
    <axis> 
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>select</type>
    <object-name>needle_essbus</object-name>
    <condition>
      <equals>
        <property>controls/switches/vm</property>
        <value>3</value>
      </equals>
    </condition>
  </animation>
  <animation> 
    <type>rotate</type>
    <object-name>needle_essbus</object-name>
    <property>systems/electrical/outputs/essential_bus</property>s
    <interpolation>
      <entry><ind>  0 </ind><dep> -54 </dep></entry>
      <entry><ind> 15 </ind><dep>   0 </dep></entry>
      <entry><ind> 30 </ind><dep>  54 </dep></entry>
    </interpolation>
    <center>
      <x-m> -0.001 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> -0.015 </z-m>  
    </center>
    <axis> 
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>select</type>
    <object-name>needle_nonessbus</object-name>
    <condition>
      <equals>
        <property>controls/switches/vm</property>
        <value>4</value>
      </equals>
    </condition>
  </animation>
  <animation> 
    <type>rotate</type>
    <object-name>needle_nonessbus</object-name>
    <property>systems/electrical/outputs/nonessential_bus</property>s
    <interpolation>
      <entry><ind>  0 </ind><dep> -54 </dep></entry>
      <entry><ind> 15 </ind><dep>   0 </dep></entry>
      <entry><ind> 30 </ind><dep>  54 </dep></entry>
    </interpolation>
    <center>
      <x-m> -0.001 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> -0.015 </z-m>  
    </center>
    <axis> 
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

</PropertyList>
