<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>vsi.ac</path>

  <effect>
    <inherits-from>Aircraft/bell205/Models/Effects/reflectglasint-uber</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <effect>
    <condition>
      <property>sim/rendering/rembrandt/enabled</property>
    </condition>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>range</type>
    <object-name>vitre</object-name>
    <object-name>face</object-name>
    <object-name>needle</object-name>  
    <object-name>fond</object-name>
    <min-m>0</min-m>
    <max-m>20</max-m>
  </animation>

  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>needle</object-name>  
    <condition>
      <property>systems/electrical/outputs/inst_panel_lights</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instltg/copilot</factor-prop>
      <red>   0.1 </red>
      <green> 0.1 </green>
      <blue>  0.1 </blue>
    </emission>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>needle</object-name>
    <property>instrumentation/vertical-speed-indicator/indicated-speed-fpm</property>
      <interpolation>
        <entry><ind> -2000 </ind><dep> -173.5 </dep></entry>
        <entry><ind> -1500 </ind><dep> -131.5 </dep></entry>
        <entry><ind> -1000 </ind><dep>  -81.5 </dep></entry>
        <entry><ind>  -500 </ind><dep>  -35.3 </dep></entry>
        <entry><ind>     0 </ind><dep>    0.0 </dep></entry>
        <entry><ind>   500 </ind><dep>   35.7 </dep></entry>
        <entry><ind>  1000 </ind><dep>   81.5 </dep></entry>
        <entry><ind>  1500 </ind><dep>  131.0 </dep></entry>
        <entry><ind>  2000 </ind><dep>  172.9 </dep></entry>
      </interpolation>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

</PropertyList>
