<?xml version="1.0" encoding="iso-8859-1"?>

<PropertyList>

  <path>stdby-adi.ac</path>

  <effect>
    <inherits-from>Aircraft/bell205/Models/Effects/reflectglasint-uber</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <effect>
    <condition>
      <property>sim/rendering/rembrandt/enabled</property>
    </condition>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>range</type>
    <object-name>vitre</object-name>
    <object-name>ring</object-name>
    <object-name>bank-index</object-name>
    <object-name>scale</object-name>
    <object-name>drum</object-name>
    <object-name>plane</object-name>
    <object-name>back</object-name>
    <object-name>bkg</object-name>
    <object-name>button</object-name>
    <object-name>support</object-name>
    <object-name>fond</object-name>
    <min-m>0</min-m>
    <max-m>20</max-m>
  </animation>

  <animation>
    <type>material</type>
    <object-name>ring</object-name>
    <object-name>bank-index</object-name>
    <object-name>scale</object-name>
    <object-name>drum</object-name>
    <object-name>plane</object-name>
    <condition>
      <property>systems/electrical/outputs/inst_panel_lights</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instltg/copilot</factor-prop>
      <red>   0.1 </red>
      <green> 0.1 </green>
      <blue>  0.1 </blue>
    </emission>
  </animation>


  <animation>
    <type>rotate</type>
    <object-name>drum</object-name>
    <property>orientation/roll-deg</property>
    <center>
      <x-m> -0.0113 </x-m>
      <y-m>  0.0000 </y-m>
      <z-m>  0.0000 </z-m>
    </center>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>drum</object-name>
    <property>orientation/pitch-deg</property>
    <factor>1.5</factor>
    <center>
      <x-m> -0.0117 </x-m>
      <y-m>  0.0000 </y-m>
      <z-m>  0.0000 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>ring</object-name>
    <property>orientation/roll-deg</property>
    <center>
      <x-m> 0 </x-m>
      <y-m> 0 </y-m>
      <z-m> 0 </z-m>
    </center>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>bank-index</object-name>
    <property>orientation/roll-deg</property>
    <center>
      <x-m> 0 </x-m>
      <y-m> 0 </y-m>
      <z-m> 0 </z-m>
    </center>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

</PropertyList>
