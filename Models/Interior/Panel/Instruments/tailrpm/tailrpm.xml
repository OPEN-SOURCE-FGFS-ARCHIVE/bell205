<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>tailrpm.ac</path>

  <effect>
    <inherits-from>Aircraft/bell205/Models/Effects/reflectglasint-uber</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <effect>
    <condition>
      <property>sim/rendering/rembrandt/enabled</property>
    </condition>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>range</type>
    <object-name>vitre</object-name>
    <object-name>face</object-name>
    <object-name>needle1</object-name>
    <object-name>needle2</object-name>
    <object-name>fond</object-name>
    <min-m>0</min-m>
    <max-m>20</max-m>
  </animation>

  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>needle1</object-name>
    <object-name>needle2</object-name>
    <condition>
      <property>systems/electrical/outputs/inst_panel_lights</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instltg/engine</factor-prop>
      <red>   0.1 </red>
      <green> 0.1 </green>
      <blue>  0.1 </blue>
    </emission>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>needle1</object-name>
    <property>rotors/tail/rpm</property>
    <interpolation>
      <entry><ind>    0 </ind><dep>    0 </dep></entry>
      <entry><ind> 1620 </ind><dep>  270 </dep></entry>
    </interpolation>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>needle2</object-name>
    <property>rotors/tail/torque</property>
    <interpolation>
      <entry><ind>   0 </ind><dep>   0 </dep></entry>
      <entry><ind> 350 </ind><dep> 180 </dep></entry>
      <entry><ind> 705 </ind><dep> 360 </dep></entry>
    </interpolation>
    <center>
      <x-m>  0.001 </x-m>
      <y-m> -0.008 </y-m>
      <z-m>  0.009 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

</PropertyList>
