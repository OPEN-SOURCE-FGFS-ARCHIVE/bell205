<?xml version="1.0"?>

<PropertyList>

  <path>temp.ac</path>

  <effect>
    <inherits-from>Aircraft/bell205/Models/Effects/reflectglasint-uber</inherits-from>
    <object-name>glas</object-name>
  </effect>

  <effect>
    <condition>
      <property>sim/rendering/rembrandt/enabled</property>
    </condition>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>glas</object-name>
  </effect>

  <animation>
    <type>range</type>
    <object-name>glas</object-name>
    <object-name>face</object-name>
    <object-name>needle</object-name>
    <object-name>fond</object-name>
    <min-m>0</min-m>
    <max-m>20</max-m>
  </animation>

  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>needle</object-name>
    <condition>
      <property>systems/electrical/outputs/inst_panel_lights</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instltg/pilot</factor-prop>
      <red>   0.1 </red>
      <green> 0.1 </green>
      <blue>  0.1 </blue>
    </emission>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>needle</object-name>
    <property>environment/temperature-degc</property>
    <condition>
      <property>systems/electrical/outputs/bus_avionics</property>
    </condition>
    <interpolation>
      <entry><ind> -60 </ind><dep> -39 </dep></entry>
      <entry><ind>   0 </ind><dep>   0 </dep></entry>
      <entry><ind>  60 </ind><dep>  42 </dep></entry>
    </interpolation>
    <center>
      <x-m> -0.001 </x-m>
      <y-m>  0     </y-m>
      <z-m> -0.040 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

</PropertyList>
