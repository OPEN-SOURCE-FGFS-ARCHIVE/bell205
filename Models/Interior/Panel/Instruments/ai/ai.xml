<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>ai.ac</path>

  <effect>
    <inherits-from>Aircraft/bell205/Models/Effects/reflectglasint-uber</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <effect>
    <condition>
      <property>sim/rendering/rembrandt/enabled</property>
    </condition>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>range</type>
    <object-name>vitre</object-name>
    <object-name>face</object-name>
    <object-name>ball</object-name>
    <object-name>aircraft</object-name>  
    <object-name>fond</object-name>
    <object-name>visses</object-name>
    <min-m>0</min-m>
    <max-m>20</max-m>
  </animation>
  
  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>ball</object-name>
    <object-name>aircraft</object-name>  
    <condition>
      <property>systems/electrical/outputs/inst_panel_lights</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instltg/pilot</factor-prop>
      <red>   0.1 </red>
      <green> 0.1 </green>
      <blue>  0.1 </blue>
    </emission>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>ball</object-name>
    <property>orientation/roll-deg</property>
    <condition>
      <property>systems/electrical/outputs/attd_pilot</property>
    </condition>
    <factor>1</factor>
    <center>
      <x-m> -0.062 </x-m>
      <y-m>  0.000 </y-m>
      <z-m>  0.000 </z-m>
    </center>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>  

  <animation>
    <type>rotate</type>
    <object-name>ball</object-name>
    <property>orientation/pitch-deg</property>
    <condition>
      <property>systems/electrical/outputs/attd_pilot</property>
    </condition>
    <factor>1</factor>
    <center>
      <x-m> -0.062 </x-m>
      <y-m>  0.000 </y-m>
      <z-m>  0.000 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>  

