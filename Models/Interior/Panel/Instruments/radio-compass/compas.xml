<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <path>compas.ac</path>

  <effect>
    <inherits-from>Aircraft/bell205/Models/Effects/reflectglasint-uber</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <effect>
    <condition>
      <property>sim/rendering/rembrandt/enabled</property>
    </condition>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>range</type>
    <object-name>vitre</object-name>
    <object-name>compass</object-name>
    <object-name>rect</object-name>
    <object-name>visses</object-name>
    <object-name>fond</object-name>
    <min-m>0</min-m>
    <max-m>20</max-m>
  </animation>

  <animation>
    <type>material</type>
    <object-name>compass</object-name>
    <object-name>rect</object-name>
    <condition>
      <property>systems/electrical/outputs/inst_panel_lights</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instltg/pilot</factor-prop>
      <red>   0.1 </red>
      <green> 0.1 </green>
      <blue>  0.1 </blue>
    </emission>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>compass</object-name>
    <property>orientation/heading-deg</property>
    <center>
      <x-m>-0.020</x-m>
      <y-m>-0.000</y-m>
      <z-m> 0.000</z-m>
    </center>
    <axis>
      <x> 0</x>
      <y> 0</y>
      <z>1</z>
    </axis>
  </animation>

</PropertyList>
