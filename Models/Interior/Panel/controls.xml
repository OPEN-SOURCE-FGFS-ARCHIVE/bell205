<!-- search light switch -->
  <animation>
    <type>knob</type>
    <object-name>sl_switch</object-name>
    <property>controls/switches/search_light</property>
    <center>
      <x-m>0.155</x-m>
      <y-m>0.000</y-m>
      <z-m>0.099</z-m>
    </center>
    <axis>
      <x> 0</x>
      <y>-1</y>
      <z> 0</z>
    </axis>
    <factor>12.5</factor>
    <action>
      <binding>
        <command>property-toggle</command>
       <property>controls/switches/search_light</property>
<!--       <command>property-adjust</command>
       <property>controls/switches/search_light</property>
       <min>-1</min>
       <max> 1</max>
       <wrap>false</wrap> -->
      </binding>
      <binding>
        <command>property-toggle</command>
        <property>sim/sound/click</property>
      </binding>
    </action>
  </animation>

</PropertyList>
