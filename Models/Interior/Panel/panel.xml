<!-- rotor rpm warning -->
  <animation>
    <type>select</type>
    <object-name>rpmwarnlight</object-name>
    <condition>
      <property>systems/electrical/outputs/rpm_warn_system</property>
      <property>controls/switches/engine/mainfuel</property>
      <or>
        <less-than>
          <property>rotors/main/rpm</property>
          <value>300</value>
        </less-than>
        <greater-than>
          <property>rotors/main/rpm</property>
          <value>340</value>
        </greater-than>
      </or>
    </condition>
  </animation>

  <animation>
    <type>material</type>
    <object-name>rpmwarnlight</object-name>
    <emission>
      <red>  1.0</red>
      <green>1.0</green>
      <blue> 1.0</blue>
