  <!-- tail light -->
  <animation>
    <type>light</type>
    <light-type>spot</light-type>
    <name>tail</name>
    <object-name>tail</object-name>
    <nopreview/>
    <position>
      <x>9.917</x>
      <y>-0.05</y>
      <z>2.608</z>
    </position>
    <direction>
      <x> 1.0</x>
      <y> 0.0</y>
      <z> 0.0</z>
    </direction>
    <ambient>
      <r>0.99</r>
      <g>0.99</g>
      <b>0.96</b>
      <a>1.0</a>
    </ambient>
    <diffuse>
      <r>0.99</r>
      <g>0.99</g>
      <b>0.96</b>
      <a>1.0</a>
    </diffuse>
    <specular>
      <r>0.99</r>
      <g>0.99</g>
      <b>0.96</b>
      <a>1.0</a>
    </specular>
    <attenuation>
      <c>1.0</c>
      <l>0.0</l>
      <q>0.75</q>
    </attenuation>
    <exponent>3</exponent>
    <near-m>0.01</near-m>
    <far-m>36</far-m>
    <cutoff>150</cutoff>
  </animation>

  <animation>
    <type>select</type>
    <object-name>tail</object-name>
    <condition>
      <property>sim/multiplay/generic/int[6]</property>
    </condition>
  </animation>

