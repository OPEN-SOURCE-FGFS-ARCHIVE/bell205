<?xml version="1.0" encoding="UTF-8"?><PropertyList><!-- ==                                   == --><!-- == ROTOR PARTICLE SYSTEMS ANIMATIONS == --><!-- ==                                   == --><!-- dry particles -->  <model>    <name>dirt_01</name>    <path>Aircraft/bell205/Models/Effects/particle/rotor_particle_dry_H.xml</path>    <offsets>      <x-m>  2.973 </x-m>      <y-m>  0.000 </y-m>      <z-m> -1.900 </z-m>    </offsets>  </model>  <model>    <name>dirt_02</name>    <path>Aircraft/bell205/Models/Effects/particle/rotor_particle_dry_L.xml</path>    <offsets>      <x-m>  2.973 </x-m>      <y-m>  0.000 </y-m>      <z-m> -1.500 </z-m>    </offsets>  </model><!-- wet particles -->  <model>    <name>dirt_03</name>    <path>Aircraft/bell205/Models/Effects/particle/rotor_particle_wet_H.xml</path>    <offsets>      <x-m>  2.973 </x-m>      <y-m>  0.000 </y-m>      <z-m> -1.000 </z-m>    </offsets>  </model>  <model>    <name>dirt_04</name>    <path>Aircraft/bell205/Models/Effects/particle/rotor_particle_wet_L.xml</path>    <offsets>      <x-m>  2.973 </x-m>      <y-m>  0.000 </y-m>      <z-m> -0.400 </z-m>    </offsets>  </model>  <animation>    <name>dirt</name>    <object-name>dirt_01</object-name>    <object-name>dirt_02</object-name>    <object-name>dirt_03</object-name>    <object-name>dirt_04</object-name>  </animation><!-- move particle system with pitch and roll -->  <animation>    <type>rotate</type>    <object-name>dirt</object-name>    <property>/sim/multiplay/generic/float[7]</property> <!-- pitch-deg -->    <factor>2</factor>    <axis>      <x>0</x>      <y>-1</y>      <z>0</z>    </axis>  </animation>  <animation>    <type>rotate</type>    <object-name>dirt</object-name>    <property>/sim/multiplay/generic/float[8]</property> <!-- roll-deg -->    <factor>2</factor>    <axis>      <x>1</x>      <y>0</y>      <z>0</z>    </axis>  </animation>  <animation>    <type>translate</type>    <object-name>dirt</object-name>    <property>/sim/multiplay/generic/float[0]</property> <!-- agl-m --><!--    <offset>0.5</offset> -->    <factor>2</factor>    <axis>      <x>0</x>      <y>0</y>      <z>-1</z>    </axis>  </animation><!-- move particle system with rotor tilt -->  <animation>    <object-name>dirt</object-name>    <property>/sim/multiplay/generic/float[8]</property> <!-- roll-deg -->    <factor>5</factor>    <center>      <x-m> 2.973</x-m>      <y-m> 0.000</y-m>      <z-m> 1.751</z-m>    </center>    <axis>      <x>1</x>      <y>0</y>      <z>0</z>    </axis>  </animation>	  <animation>    <object-name>dirt</object-name>    <property>/sim/multiplay/generic/float[11]</property> <!-- yaw-deg -->    <factor>5</factor>    <center>      <x-m> 2.973</x-m>      <y-m> 0.000</y-m>      <z-m> 1.751</z-m>    </center>    <axis>      <x>0</x>      <y>1</y>      <z>0</z>    </axis>  </animation></PropertyList>