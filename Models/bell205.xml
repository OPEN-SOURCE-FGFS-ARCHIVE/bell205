  <nasal>
    <load>
      var livery_update = aircraft.livery_update.new(
        "Aircraft/bell205/Models/Liveries", 10,	func{ print( "Bell205 livery update" ) }
      );

      <![CDATA[
        var a = "sim/multiplay/generic/float[7]";
        a = "sim/multiplay/generic/float[8]";
        a = "sim/multiplay/generic/float[9]";
        a = "sim/multiplay/generic/float[10]";
        a = "sim/multiplay/generic/float[11]";

        var mppath = "/ai/models/multiplayer["~ cmdarg().getIndex() ~"]/";
        var lightpath = mppath~"lighting/";
        props.globals.initNode( mppath~"sim/is-MP-Aircraft", 1, "BOOL" );

        var modeswitch   = mppath~"sim/multiplay/generic/float[17]";
        var beaconswitch = mppath~"sim/multiplay/generic/int[6]";
        var strobeswitch = mppath~"sim/multiplay/generic/int[4]";

        var beacon = nil;
        if( beaconswitch!=nil ){
          beacon = aircraft.light.new( lightpath~"beacon", [0.85, 0.85], beaconswitch );
          setlistener( modeswitch, func(){
            var bmode = props.globals.getNode( modeswitch ).getValue();
            if( bmode == -1.0 ){
              beacon.blink();
            }else if( bmode == 1.0 ){
              beacon.cont();
            }else{  # bmode == 0.0
              beacon.switch( 0 );
            }
          }, 1, 0 );
        }

        var strobe = nil;
        var strobe2 = nil;
        if( strobeswitch!=nil ){
          strobe =  aircraft.light.new( lightpath~"strobe-state",  [0.05, 1.00], strobeswitch );
          strobe2 = aircraft.light.new( lightpath~"strobe-state2", [0.05, 1.05], strobeswitch );
        }
      ]]>
    </load>

    <unload>
      livery_update.stop();

      if( beaconswitch != nil ){
        setprop( beaconswitch, 0 );
      }
      beacon.del();
      beacon = nil;
      
      if( strobeswitch != nil ){
        setprop( strobeswitch, 0 );
      }
      strobe.del();
      strobe = nil;
    </unload>
  </nasal>
  
