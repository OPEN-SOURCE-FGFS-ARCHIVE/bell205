<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>shadow2.ac</path>

  <animation>
    <type>noshadow</type>
    <object-name>shadowfuselage</object-name>
    <object-name>shadowrotor</object-name>
    <object-name>shadowsprayer</object-name>
  </animation>

  <!-- Une ombre pour OSG en attendant mieux ;) base sur l'ombre du DC 3-->
  <animation>
    <name>AllShadow</name>
    <object-name>shadowfuselage</object-name>
    <object-name>shadowrotor</object-name>
    <object-name>shadowsprayer</object-name>
  </animation>

  <animation>
    <type>select</type>
    <object-name>AllShadow</object-name>
    <condition>
      <and>
        <not><property>sim/freeze/replay-state</property></not>
        <property>sim/rendering/shadows/enabled</property>
        <not><property>sim/rendering/rembrandt/enabled</property></not>
      </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>shadowsprayer</object-name>
    <condition>
      <property>sim/model/hide-sprayer</property>
    </condition>
  </animation>

  <!-- pitch -->
  <animation>
    <type>rotate</type>
    <object-name>AllShadow</object-name>
    <property>orientation/pitch-deg</property>
    <factor> -1 </factor>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- roll -->
  <animation>
    <type>rotate</type>
    <object-name>AllShadow</object-name>
    <property>orientation/roll-deg</property>
    <factor> 1</factor>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- Translate to ground level -->
  <animation>
   <type>translate</type>
   <object-name>AllShadow</object-name>
   <property>position/gear-agl-m</property>
   <factor> -1 </factor>
   <axis>
     <x> 0 </x>
     <y> 0 </y>
     <z> 1 </z>
   </axis>
  </animation>

  <animation>
    <type>select</type>
    <object-name>shadowrotor</object-name>
    <condition>
      <less-than>
        <property>/rotors/main/rpm</property>
        <value>75</value>
      </less-than>
    </condition>
  </animation>
  
  <animation>
    <type>rotate</type>
    <object-name>shadowrotor</object-name>
    <property>rotors/main/blade[0]/position-deg</property>
    <center>
       <x-m> -3.468 </x-m>
       <y-m>  0.000 </y-m>
       <z-m>  0.000 </z-m>
    </center>
    <axis>
      <x>  0 </x>
      <y>  0 </y>
      <z>  1 </z>
    </axis>
  </animation>

</PropertyList>
