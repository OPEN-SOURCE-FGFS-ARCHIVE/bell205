      <z-m>-1.000</z-m>
    </center>
    <axis>
      <x>1</x>
      <y>0</y>
      <z>0</z>
    </axis>
  </animation>
  <animation>
    <type>rotate</type>
    <object-name>handr</object-name>
    <property>controls/flight/elevator</property>
    <factor>-5.5</factor>
    <center>
      <x-m>-0.450</x-m>
      <y-m> 0.000</y-m>
