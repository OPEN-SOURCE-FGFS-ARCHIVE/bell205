      <z-m>-1.000</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>1</y>
      <z>0</z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>armr</object-name>
    <property>controls/flight/aileron</property>
    <factor>-28</factor>
    <center>
      <x-m>0.087</x-m>
      <y-m>0.130</y-m>
      <z-m>0.289</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>0</y>
      <z>1</z>
    </axis>
  </animation>
  <animation>
    <type>rotate</type>
    <object-name>armr</object-name>
    <property>controls/flight/elevator</property>
    <factor>15</factor>
    <center>
      <x-m>0.074</x-m>
      <y-m>0.189</y-m>
      <z-m>0.286</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>1</y>
      <z>0</z>
    </axis>
  </animation>

  <!-- right leg -->
  <animation>
    <type>rotate</type>
    <object-name>legr</object-name>
    <property>controls/flight/rudder</property>
    <factor>6</factor>
    <center>
      <x-m>-0.497</x-m>
      <y-m> 0.000</y-m>
      <z-m>-0.134</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>1</y>
      <z>0</z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>footr</object-name>
    <property>controls/flight/rudder</property>
    <factor>13</factor>
    <center>
      <x-m>-0.830</x-m>
      <y-m>-0.132</y-m>
      <z-m>-0.390</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>-1</y>
      <z>0</z>
    </axis>
  </animation>

  <animation>
    <type>translate</type>
    <object-name>footr</object-name>
    <property>controls/flight/rudder</property>
    <factor>0.07</factor>
    <axis>
      <x>-1</x>
      <y>0</y>
      <z>0</z>
    </axis>
  </animation>
  
  <!-- left leg -->
  <animation>
    <type>rotate</type>
    <object-name>legl</object-name>
    <property>controls/flight/rudder</property>
    <factor>6.5</factor>
    <center>
      <x-m>-0.451</x-m>
      <y-m> 0.107</y-m>
      <z-m>-0.132</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>-1</y>
      <z>0</z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>footl</object-name>
    <property>controls/flight/rudder</property>
    <factor>13</factor>
    <center>
      <x-m>-0.830</x-m>
      <y-m>-0.132</y-m>
      <z-m>-0.390</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>1</y>
      <z>0</z>
    </axis>
  </animation>

  <animation>
    <type>translate</type>
    <object-name>footl</object-name>
    <property>controls/flight/rudder</property>
    <factor>0.07</factor>
    <axis>
      <x>1</x>
      <y>0</y>
      <z>0</z>
    </axis>
  </animation>

</PropertyList>
