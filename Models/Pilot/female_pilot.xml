<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>female_pilot.ac</path>

  <animation>
    <type>select</type>
    <object-name>arml</object-name>
    <object-name>armr</object-name>
    <object-name>corps</object-name>
    <object-name>footl</object-name>
    <object-name>footr</object-name>
    <object-name>forearml</object-name>
    <object-name>forearmr</object-name>
    <object-name>handl</object-name>
    <object-name>handr</object-name>
    <object-name>head</object-name>
    <object-name>legl</object-name>
    <object-name>legr</object-name>
    <object-name>skirt</object-name>
    <object-name>thighl</object-name>
    <object-name>thighr</object-name>
    <condition>
      <not>
        <property>sim/multiplay/generic/int[7]</property>
      </not>
    </condition>
  </animation>

  <!-- head -->
  <animation>
    <type>rotate</type>
    <object-name>head</object-name>
    <property>controls/flight/elevator</property>
    <factor>-15</factor> 
    <center>
      <x-m>0.000</x-m>
      <y-m>0.000</y-m>
      <z-m>0.280</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>1</y>
      <z>0</z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>head</object-name>
    <property>controls/flight/rudder</property>
    <factor>-25</factor>
    <center>
      <x-m>0.050</x-m>
      <y-m>0.000</y-m>
      <z-m>0.000</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>0</y>
      <z>1</z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>head</object-name>
    <property>controls/flight/aileron</property>
    <factor>-10.0</factor>
    <center>
      <x-m>0.000</x-m>
      <y-m>0.000</y-m>
      <z-m>0.330</z-m>
    </center>
    <axis>
      <x>1</x>
      <y>0</y>
      <z>0</z>
    </axis>
  </animation> 

  <!-- left arm -->
  <animation>
    <type>rotate</type>
    <object-name>handl</object-name>
    <property>controls/engines/engine/throttle</property>
    <factor>-15.5</factor>
    <center>
      <x-m> 0.170</x-m>
      <y-m> 0.000</y-m>
      <z-m>-0.650</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>1</y>
      <z>0</z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>forearml</object-name>
    <property>controls/engines/engine/throttle</property>
    <factor>-15.5</factor>
    <center>
      <x-m>  0.170 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> -0.700 </z-m>
    </center>
    <axis>
      <x>0</x>
      <y>1</y>
      <z>0</z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>forearml</object-name>
    <property>controls/engines/engine/throttle</property>
    <factor>-20</factor>
    <center>
      <x-m>-0.164</x-m>
      <y-m>-0.267</y-m>
      <z-m>-0.099</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>1</y>
      <z>0</z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>arml</object-name>
    <property>controls/engines/engine/throttle</property>
    <factor>36</factor>
    <center>
      <x-m> 0.079</x-m>
      <y-m>-0.102</y-m>
      <z-m> 0.251</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>1</y>
      <z>0</z>
    </axis>
  </animation>

<!-- right arm -->
  <animation>
    <type>rotate</type>
    <object-name>handr</object-name>
    <property>controls/flight/aileron</property>
    <factor>-4.5</factor>
    <center>
      <x-m> 2.500</x-m>
