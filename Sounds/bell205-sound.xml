<!-- inside -->
    <rotor>
      <name>rotorinside</name>
      <mode>looped</mode>
      <path>Aircraft/bell205/Sounds/inside_noflap.wav</path>
      <condition>
        <and>
          <not>
            <property>sim/crashed</property>
          </not>
          <greater-than>
            <property>rotors/main/rpm</property>
            <value>50</value>
          </greater-than>
          <or>
            <equals>
              <property>sim/current-view/view-number</property>
              <value>0</value>
            </equals>
            <greater-than>
              <property>sim/current-view/view-number</property>
              <value>8</value>
            </greater-than>
          </or>
        </and>
      </condition>
      <volume>
        <property>rotors/gear/torque-sound-filtered</property>
      </volume>
      <pitch>
        <property>rotors/main/rpm</property>
        <factor>0.00325</factor>
        <offset>-0.0</offset>
        <max>2.5</max>
      </pitch>
      <reference-dist>500</reference-dist>
      <max-dist>1000</max-dist>
    </rotor>

    <rotor>
      <name>rotorinsidedooropen</name>
      <mode>looped</mode>
      <path>Aircraft/bell205/Sounds/inside_flap.wav</path>
      <condition>
        <and>
          <not>
            <property>sim/crashed</property>
          </not>
          <greater-than>
            <property>rotors/main/rpm</property>
            <value>50</value>
          </greater-than>
          <property>sim/model/doors/door_status</property>
          <or>
            <equals>
              <property>sim/current-view/view-number</property>
              <value>0</value>
            </equals>
            <greater-than>
              <property>sim/current-view/view-number</property>
              <value>8</value>
            </greater-than>
          </or>
        </and>
      </condition>
      <volume>
        <property>rotors/gear/torque-sound-filtered</property>
      </volume>
      <pitch>
        <property>rotors/main/rpm</property>
        <factor>0.00325</factor>
        <offset>-0.0</offset>
        <max>2.5</max>
      </pitch>
      <reference-dist>500</reference-dist>
      <max-dist>1000</max-dist>
    </rotor>

    <overspeed>
      <name>overspeed</name>
      <mode>looped</mode>
      <path>Aircraft/bell205/Sounds/overspeed.wav</path>
      <condition>
        <greater-than>
          <property>velocities/airspeed-kt</property>
          <value>120</value>
        </greater-than>
      </condition>
      <volume>
        <factor>1.0</factor> <!-- 0.2 -->
      </volume>
      <pitch>
        <factor>0.9</factor> <!-- 0.1 -->
      </pitch>
      <reference-dist>1.0</reference-dist>
      <max-dist>2.0</max-dist>
    </overspeed>

    <contact>
      <name>ground contact</name>
      <mode>once</mode>
      <path>Aircraft/bell205/Sounds/TC1.wav</path>
      <condition>
        <property>gear/gear[0]/wow</property>
        <property>gear/gear[1]/wow</property>
        <property>gear/gear[2]/wow</property>
        <property>gear/gear[3]/wow</property>
      </condition>
      <volume>
        <factor>0.8</factor>
      </volume>
      <pitch>
        <factor>0.01</factor>
      </pitch>
      <reference-dist>5.0</reference-dist>
      <max-dist>10.0</max-dist>
    </contact>

    <wind>
      <name>wind</name>
      <mode>looped</mode>
      <path>Sounds/wind.wav</path>
      <condition>
        <and>
          <property>velocities/airspeed-kt</property>
          <not>
            <property>sim/crashed</property>
          </not>
        </and>
      </condition>
      <volume>
        <property>velocities/airspeed-kt</property>
        <factor>0.0015</factor>
        <min>0.00</min>
        <max>0.25</max>
      </volume>
      <pitch>
        <property>velocities/airspeed-kt</property>
        <factor>0.01</factor>
        <offset>1.25</offset>
      </pitch>
      <reference-dist>10.0</reference-dist>
      <max-dist>20.0</max-dist>
    </wind>

    <crash>
      <name>intense ground contact</name>
      <mode>once</mode>
      <path>Aircraft/bell205/Sounds/crash.wav</path>
      <property>sim/crashed</property>
      <volume>
        <factor>1</factor>
      </volume>
      <pitch>
        <factor>0.1</factor>
      </pitch>
      <reference-dist>500</reference-dist>
      <max-dist>1000</max-dist>
    </crash>
        
    <!-- switches -->
    <click>
      <name>switches on</name>
      <type>avionics</type>
      <mode>once</mode>
      <path>Aircraft/bell205/Sounds/click.wav</path>
      <max-dist>10</max-dist>
      <reference-dist>5</reference-dist>
      <condition>
        <property>sim/sound/click</property>
      </condition>
      <volume>
        <property>sim/sound/volume</property>
      </volume>
    </click>

    <click>
      <name>switches off</name>
      <type>avionics</type>
      <mode>once</mode>
      <path>Aircraft/bell205/Sounds/click.wav</path>
      <max-dist>10</max-dist>
      <reference-dist>5</reference-dist>
      <condition>
        <not>
          <property>sim/sound/click</property>
        </not>
      </condition>
      <volume>
        <property>sim/sound/volume</property>
      </volume>
    </click>

    <!-- sounder/alarm -->
    <alarm>
      <name>alarm</name>
      <mode>looped</mode>
      <path>Aircraft/bell205/Sounds/alarm.wav</path>
      <max-dist>20</max-dist>
      <reference-dist>2</reference-dist>
      <condition>
        <property>systems/electrical/outputs/sounds/sounder</property>
      </condition>
      <volume>
        <property>sim/sound/volume</property>
      </volume>
    </alarm>

  </fx>

</PropertyList>
