<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <fx>

    <engine>
      <name>engine-start</name>
      <mode>once</mode>
      <path>Aircraft/bell205/Sounds/v22_turbine_strt_out.wav</path>
      <condition>
        <greater-than>
          <property>sim/model/bell205/state</property>
          <value>0</value>
        </greater-than>
      </condition>
      <volume>
        <factor>0.7</factor>
      </volume>
      <reference-dist>500</reference-dist>
      <max-dist>4000</max-dist>
    </engine>

    <engine>
      <name>turbine</name>
      <mode>looped</mode>
      <path>Sounds/turbine_loop.wav</path>
      <condition>
        <and>
          <greater-than>
            <property>rotors/main/rpm</property>
            <value>50</value>
          </greater-than>
          <greater-than>
            <property>sim/model/bell205/state</property>
            <value>1</value>
          </greater-than>
          <not>
            <property>sim/crashed</property>
          </not>
        </and>
      </condition>
      <volume>
        <property>rotors/gear/torque-sound-filtered</property>
        <factor>0.3</factor>
      </volume>
      <pitch>
        <property>rotors/main/rpm</property>
        <factor>0.003125</factor>
        <offset>-0.0</offset>
        <max>1.03</max>
      </pitch>
      <position>
        <x>-3.7</x>
        <y> 0.0</y>
        <z> 0.4</z>
      </position>
      <reference-dist>500</reference-dist>
      <max-dist>4000</max-dist>
    </engine>

    <!-- outside -->
    <!-- rotor -->
    <rotor>
      <name>rotor</name>
      <mode>looped</mode>
      <path>Aircraft/bell205/Sounds/outside_noflap.wav</path>
      <condition>
        <and>
          <greater-than>
            <property>rotors/main/rpm</property>
            <value>50</value>
          </greater-than>
          <not>
            <property>sim/crashed</property>
          </not>
            <or>
              <equals>
                <property>sim/current-view/view-number</property>
                <value>0</value>
              </equals>
              <less-than>
                <property>sim/current-view/view-number</property>
                <value>100</value>
              </less-than>
            </or>
        </and>
      </condition>
      <volume>
        <property>rotors/gear/torque-sound-filtered</property>
      </volume>
      <pitch>
        <property>rotors/main/rpm</property>
        <factor>0.003125</factor>
        <offset>-0.0</offset>
        <max>2.5</max>
      </pitch>
      <position>
        <x>-4.9</x>
        <y> 0.0</y>
        <z> 1.5</z>
      </position>
      <reference-dist>500</reference-dist>
      <max-dist>5000</max-dist>
    </rotor>

    <rotor>
      <name>tail_rotor</name>
      <mode>looped</mode>
      <path>Aircraft/bell205/Sounds/tailrotor.wav</path>
      <condition>
        <and>
          <greater-than>
            <property>rotors/main/rpm</property>
            <value>50</value>
          </greater-than>
          <not>
            <property>sim/crashed</property>
          </not>
<!--          <not>
            <or>
              <equals>
                <property>sim/current-view/view-number</property>
                <value>0</value>
              </equals> -->
              <or>
                <greater-than>
                  <property>sim/current-view/view-number</property>
                  <value>0</value>
                </greater-than>
                <less-than>
                  <property>sim/current-view/view-number</property>
                  <value>8</value>
                </less-than>
              </or>
              <!--            </or>
          </not> -->
        </and>
      </condition>
      <volume>
        <property>rotors/gear/torque-sound-filtered</property>
        <factor>0.75</factor>
      </volume>
      <pitch>
        <property>rotors/tail/rpm</property>
        <factor>0.0006</factor>
        <offset>-0.0</offset>
        <max>2.5</max>
      </pitch>
      <position>
        <x>-2.0</x>
        <y>-0.4</y>
        <z> 1.3</z>
      </position>
      <orientation>
        <x> 1 </x>
        <y> . </y>
        <z> 0 </z>
        <inner-angle>110</inner-angle>
        <outer-angle>220</outer-angle>
        <outer-gain>0.1</outer-gain>
      </orientation>
      <reference-dist>500</reference-dist>
      <max-dist>5000</max-dist>
    </rotor>

    <rotor>
      <name>stall</name>
      <mode>looped</mode>
      <path>Aircraft/bell205/Sounds/outside_only_flap.wav</path>
      <condition>
        <and>
          <greater-than>
            <property>rotors/main/rpm</property>
            <value>50</value>
          </greater-than>
          <not>
            <property>sim/crashed</property>
          </not>
        </and>
      </condition>
      <volume>
        <property>rotors/main/stall-filtered</property>
        <factor>160</factor>
        <max>1.0</max>
      </volume>
      <pitch>
        <property>rotors/main/rpm</property>
        <factor>0.00325</factor>
        <offset>0</offset>
        <max>2.5</max>
      </pitch>
      <reference-dist>500</reference-dist>
      <max-dist>5000</max-dist>
    </rotor>

