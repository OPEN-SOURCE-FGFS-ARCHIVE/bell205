      <yaw-deg type="float">0</yaw-deg>
    </bar2>
  </rotors>

  <orientation>
    <roll-rate-degps type="float">0</roll-rate-degps>
  </orientation>

  <consumables>
    <fuel>
      <tank>
        <ind_fuel_qty type="double">0.0</ind_fuel_qty>
        <test type="bool">false</test>
      </tank>
    </fuel>
  </consumables>

  <nasal>
    <bell205>
      <file>Aircraft/bell205/Nasal/Electrical.nas</file>
      <file>Aircraft/bell205/Nasal/autostart.nas</file>
      <file>Aircraft/bell205/Nasal/engine.nas</file>
      <file>Aircraft/bell205/Nasal/mastercaution.nas</file>
      <file>Aircraft/bell205/Nasal/doors.nas</file>
      <file>Aircraft/bell205/Nasal/utilities.nas</file>
      <file>Aircraft/bell205/Nasal/wiper.nas</file>
      <file>Aircraft/bell205/Nasal/bell205.nas</file>
    </bell205>

    <apx72>
      <file>Aircraft/bell205/Nasal/apx72.nas</file>
    </apx72>

    <arc134>
      <file>Aircraft/bell205/Nasal/arc134.nas</file>
    </arc134>

    <arc51bx>
      <file>Aircraft/bell205/Nasal/arc51bx.nas</file>
    </arc51bx>

    <arn82>
      <file>Aircraft/bell205/Nasal/arn82.nas</file>
    </arn82>

    <arn83>
