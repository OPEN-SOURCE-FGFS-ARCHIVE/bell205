    <startup>
      <splash-texture>Aircraft/bell205/thumbnail.jpg</splash-texture>
    </startup>

    <multiplay>
      <generic>
        <int n="0" type="int" alias="/gear/gear/ground-is-solid"/>
        <int n="1" type="int" alias="/smoke/particlepersec"> 50 </int>               <!-- 7 particlepersec -->
        <int n="2" type="int" alias="/systems/electrical/outputs/ldglt"/>            <!-- landing light -->
        <int n="3" type="int" alias="/systems/electrical/outputs/search_light"/>
        <int n="4" type="int" alias="/systems/electrical/outputs/anticoll_lights"/>
        <int n="5" type="int" alias="/controls/switches/extltsmode"/>                <!-- steady/flash mode -->
        <int n="6" type="int" alias="/systems/electrical/outputs/nav_lights"/>
        <int n="7" type="int" alias="/sim/model/bell205/sex-pilot"/>
        <!--        <int type="int" n="10" alias="/controls/armament/trigger">0</int>            < ! - - 10 reserved for bombable mode -->

        <float n="0"  alias="/position/gear-agl-m"> 0 </float>                        <!-- altitude -->
        <float n="1"  alias="/sim/model/bell205/door-positions/rightFrontDoor/position-norm"/>
        <float n="2"  alias="/sim/model/bell205/door-positions/leftFrontDoor/position-norm"/>
        <float n="3"  alias="/sim/model/bell205/door-positions/rightSideDoor/position-norm"/>
        <float n="4"  alias="/sim/model/bell205/door-positions/leftSideDoor/position-norm"/>
        <float n="5"  alias="/sim/model/bell205/door-positions/rightSlideDoor/position-norm"/>
        <float n="6"  alias="/sim/model/bell205/door-positions/leftSlideDoor/position-norm"/>
        <float n="7"  alias="/orientation/pitch-deg"/>
        <float n="8"  alias="/orientation/roll-deg"/>
        <float n="9"  alias="/rotors/main/torque"/>
        <float n="10" alias="/rotors/main/rpm"/>
        <float n="11" alias="/rotors/main/yaw-deg"/>
	<float n="12" alias="/sim/model/rescue"/>                           <!--winchman select -->
	<float n="13" alias="/sim/model/rescue-lift"/>                      <!--winchman translate -->
        <float n="14" alias="/instrumentation/searchlight/heading-deg"/>    <!-- landing light heading -->
        <float n="15" alias="/instrumentation/searchlight/elevation-deg"/>  <!-- landing light elevation -->
        <float n="16" alias="/controls/hoist/hoist-position"/>
        <float n="17" alias="/controls/switches/extltsmode"/>               <!-- beacon: steady/flash -->
        <string n="0" type="string">Bell 205</string>
<!--        <string n="1" type="string">bell205</string> -->
<!--        <string n="9" type="string" />                                      < ! - - string[9] reserved for bombable mode -->
      </generic>
      <chat_display>1</chat_display>
    </multiplay>

    <fuel-fraction>1.0</fuel-fraction>

    <sound>
      <path>Aircraft/bell205/Sounds/bell205-sound.xml</path>
    </sound>

    <help>
      <title>Bell 205 "Huey"</title>
      <key>
        <name>e</name>
        <desc>sprayer</desc>
      </key>
      <key>
        <name>l</name>
        <desc>toggle search light</desc>
      </key>
      <key>
        <name>L</name>
        <desc>toggle landing light</desc>
      </key>
      <key>
        <name>J</name>
        <desc>move searchlight left</desc>
      </key>
      <key>
        <name>j</name>
        <desc>move searchlight right</desc>
      </key>
      <key>
        <name>K</name>
        <desc>move searchlight up</desc>
      </key>
      <key>
        <name>k</name>
        <desc>move searchlight down</desc>
      </key>
      <key>
        <name>m</name>
        <desc>center search light</desc>
      </key>
      <key>
        <name>n</name>
        <desc>release rotor brake</desc>
      </key>
      <key>
        <name>s</name>
        <desc>trigger Starter</desc>
      </key>
      <key>
        <name>w</name>
        <desc>activate winch man ( see notes below )</desc>
      </key>
      <key>
        <name>}</name>
        <desc>winch lift</desc>
      </key>
      <key>
        <name>{</name>
        <desc>winch down</desc>
      </key>
      <line>The Winch man is only available on winch equipped load outs.</line>
      <line>He can only be seen when he has been activated and the sliding right door is fully open.</line>
      <line>To open and close the doors just click on it!</line>
    </help>

    <model>
      <path archive="y">Aircraft/bell205/Models/bell205.xml</path>
      <rescue-lift>0.01</rescue-lift>
      <rescue type="bool">false</rescue>

      <map>
        <default_exit>
          <x-offset-m type="float">-5.0</x-offset-m>
          <y-offset-m type="float">2</y-offset-m>
        </default_exit>
      </map>

      <bell205>
        <state type="int">0</state>
        <engine type="float">0</engine>
        <hide-sprayer type="bool">false</hide-sprayer>
        <rotor-step-deg type="float">-1</rotor-step-deg>
        <sex-pilot type="bool">false</sex-pilot>
        <doors>
          <door>
            <position-norm type="double">0.0</position-norm>
            <name type="string">Copilot's door</name>
          </door>
          <door>
            <position-norm type="double">0.0</position-norm>
            <name type="string">Pilot's door</name>
          </door>
          <door>
            <position-norm type="double">0.0</position-norm>
            <name type="string">left side door</name>
          </door>
          <door>
            <position-norm type="double">0.0</position-norm>
            <name type="string">right side door</name>
          </door>
          <door>
            <position-norm type="double">0.0</position-norm>
            <name type="string">left slide door</name>
          </door>
          <door>
            <position-norm type="double">0.0</position-norm>
            <name type="string">right slide door</name>
          </door>
        </doors>
      </bell205>

      <livery>
        <name type="string">default</name>
      </livery>

    </model>
	
	<rendering>
			<refl_correction type="string">-0.27</refl_correction>
			<fresnel-factor>0.2</fresnel-factor>
			
		</rendering>

    <view n="0">
      <name>Pilot</name>
      <internal type="bool">true</internal>
      <type>lookfrom</type>
      <config>
        <from-model type="bool">true</from-model>
        <dynamic-view type="bool">true</dynamic-view>
<!--        <ground-level-nearplane-m type="double">0.5f</ground-level-nearplane-m> -->
        <x-offset-m archive="y"> 0.51</x-offset-m> <!--right-->
        <y-offset-m archive="y">-0.25</y-offset-m> <!--up-->
        <z-offset-m archive="y">-6.58</z-offset-m> <!--back-->
        <pitch-offset-deg>-18</pitch-offset-deg>
        <default-field-of-view-deg>90</default-field-of-view-deg>
	  <limits>
            <enabled type="bool">true</enabled>
            <left>
              <heading-max-deg type="double">140</heading-max-deg>
              <x-offset-max-m type="double">0.20</x-offset-max-m>
              <x-offset-threshold-deg type="double">45</x-offset-threshold-deg>
            </left>
            <right>
              <heading-max-deg type="double">140</heading-max-deg>
              <x-offset-max-m type="double">0.20</x-offset-max-m>
              <x-offset-threshold-deg type="double">45</x-offset-threshold-deg>
            </right>
          </limits>
      </config>
    </view>

    <dimensions>
      <radius-m type="double">10.0</radius-m>
      <parkpos-offset-m type="double">0.0</parkpos-offset-m>
    </dimensions>
    <aircraft-class type="string">ga</aircraft-class>
    <aircraft-operator></aircraft-operator>
    <aircraft-data>
      <path>/sim/dimensions/radius-m</path>
      <path>/sim/dimensions/parkpos-offset-m</path>
      <path>/sim/aircraft-class</path>
      <path>/sim/aircraft-operator</path>
    </aircraft-data>

    <systems include="Systems/electrical_config.xml"/>
    <systems>
      <autopilot n="101">
        <path>Aircraft/bell205/Systems/glas-rain.xml</path>
      </autopilot>
    </systems>
    <checklists include="Aircraft/bell205/Dialogs/checklist_bell205.xml"/>
    <menubar include="Dialogs/bell205-menu.xml"/>

    <weight n="0">
      <name>Pilot</name>
      <weight-lb>180</weight-lb>
      <max-lb>300</max-lb>
    </weight>

    <weight n="1">
      <name>Co-Pilot</name>
      <weight-lb>180</weight-lb>
      <max-lb>300</max-lb>
    </weight>

    <weight n="2">
      <name>Right Passenger</name>
      <weight-lb>0</weight-lb>
      <max-lb>300</max-lb>
    </weight>

    <weight n="3">
      <name>Middle Passenger</name>
      <weight-lb>0</weight-lb>
      <max-lb>300</max-lb>
    </weight>

    <weight n="4">
      <name>Left Passenger</name>
      <weight-lb>0</weight-lb>
      <max-lb>300</max-lb>
    </weight>

    <weight n="5">
      <name>Load</name>
      <weight-lb>700</weight-lb>
      <max-lb>3200</max-lb>
    </weight>

    <limits>
      <vne>120</vne>
    </limits>

    <flight-recorder>
      <replay-config type="int">0</replay-config>
      <config n="0" include="Aircraft/Generic/flightrecorder/generic-helicopter.xml">
        <!-- Add some custom properties -->
        <signal>
          <type>int</type>
          <property type="string">sim/model/bell205/state</property>
        </signal>
        <signal>
          <type>int</type>
          <property type="string">controls/engines/engine/magnetos</property>
        </signal>
      </config>
    </flight-recorder>

  </sim>

