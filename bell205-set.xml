  <environment>
    <turbulence>
      <use-cloud-turbulence>true</use-cloud-turbulence>
    </turbulence>
    <precipitation-control>
      <clip-distance type="double">3.75</clip-distance>
    </precipitation-control>
  </environment>

</PropertyList>
