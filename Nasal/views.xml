<?xml version="1.0" ?>

<PropertyList>


  <view n="100">
    <name>Tail Camera View</name>
    <type>lookfrom</type>
    <internal archive="y">false</internal>
    <config>
      <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
      <ground-level-nearplane-m type="double">0.01f</ground-level-nearplane-m>
      <x-offset-m archive="y"> 0.000 </x-offset-m> <!--Right-->
      <y-offset-m archive="y"> 1.850 </y-offset-m> <!--Up-->
      <z-offset-m archive="y"> 4.118 </z-offset-m> <!--Back-->
      <pitch-offset-deg> 0 </pitch-offset-deg>
      <default-field-of-view-deg type="double"> 85 </default-field-of-view-deg>
    </config>
  </view>

  <view n="101">
    <name>Co pilot</name>
    <internal archive="y">true</internal>
    <type>lookfrom</type>
    <config>
      <from-model type="bool">true</from-model>
      <ground-level-nearplane-m type="double">0.5f</ground-level-nearplane-m>
      <x-offset-m archive="y"> -0.51 </x-offset-m> <!--right-->
      <y-offset-m archive="y"> -0.13 </y-offset-m> <!--up-->
      <z-offset-m archive="y"> -6.64 </z-offset-m> <!--back-->
      <pitch-offset-deg> -30 </pitch-offset-deg>
      <default-field-of-view-deg> 70 </default-field-of-view-deg>
      <dynamic-view type="bool">true</dynamic-view>
    </config>
  </view>

   <view n="102">
    <name>Cabin</name>
    <type>lookfrom</type>
    <internal archive="y">true</internal>
    <config>
      <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
      <ground-level-nearplane-m type="double">0.01f</ground-level-nearplane-m>
      <x-offset-m archive="y"> 0.000 </x-offset-m> <!--Right-->
      <y-offset-m archive="y"> -0.20 </y-offset-m> <!--Up-->
      <z-offset-m archive="y"> -5.51 </z-offset-m> <!--Back-->
      <pitch-offset-deg> 0 </pitch-offset-deg>
      <default-field-of-view-deg type="double"> 87 </default-field-of-view-deg>
    </config>
  </view> 
  
  <view n="103">
    <name>Cockpit</name>
    <internal type="bool">true</internal>
    <type>lookfrom</type>
    <config>
      <from-model archive="y">true</from-model>
      <ground-level-nearplane-m type="double">0.5f</ground-level-nearplane-m>
      <dynamic-view type="bool">true</dynamic-view>
      <x-offset-m archive="y">-0.03</x-offset-m> <!--Right-->
      <y-offset-m archive="y">-0.40</y-offset-m> <!--Up-->
      <z-offset-m archive="y">-6.56</z-offset-m> <!--Back-->
      <pitch-offset-deg>-52</pitch-offset-deg>
      <default-field-of-view-deg type="double">70</default-field-of-view-deg>
    </config>
  </view> 

  <view n="104">
    <name>AC Circuit Breaker Panel</name>
    <internal archive="y" type="bool">true</internal>
    <type>lookfrom</type>
    <config>
      <from-model type="bool">true</from-model>
      <ground-level-nearplane-m type="double">0.5f</ground-level-nearplane-m>
      <x-offset-m archive="y"> 0.6</x-offset-m>
      <y-offset-m archive="y">-1.1</y-offset-m>
      <z-offset-m archive="y">-7.1</z-offset-m>
      <default-field-of-view-deg> </default-field-of-view-deg>
      <pitch-offset-deg>0</pitch-offset-deg>
      <heading-offset-deg>90</heading-offset-deg>
      <dynamic-view type="bool">true</dynamic-view>
    </config>
  </view>

  <view n="0">
    <internal archive="y">true</internal>
    <config>
      <x-offset-m archive="y">  0.51 </x-offset-m> <!--right-->
      <y-offset-m archive="y"> -0.13 </y-offset-m> <!--up-->
      <z-offset-m archive="y"> -6.64 </z-offset-m> <!--back-->
      <pitch-offset-deg> -20 </pitch-offset-deg>
      <default-field-of-view-deg> 70 </default-field-of-view-deg>
    </config>
  </view>

  <view n="1">
    <config>
      <target-z-offset-m archive="y" type="double"> -4.8 </target-z-offset-m>
    </config>
  </view>

  <view n="2">
    <config>
      <target-z-offset-m archive="y" type="double"> -4.8 </target-z-offset-m>
    </config>
  </view>

  <view n="3">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view n="4">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view n="5">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view n="6">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>
  
</PropertyList>
